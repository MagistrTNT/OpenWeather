<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>G:\source\Key\sgKeyMagistrTNT.snk</AssemblyOriginatorKeyFile>
    <DelaySign>True</DelaySign>
    <RepositoryUrl>https://github.com/MagistrTNT/OpenWeather.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/MagistrTNT/OpenWeather</PackageProjectUrl>
    <Authors>MagistrTNT</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>False</IncludeSymbols>
    <PackageTags>Weathe, OpenWeathe, WebAPI</PackageTags>
    <Description>Клиент для OpenWeather api</Description>
    <PackageReleaseNotes>Запуск проекта</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.1" />
    <PackageReference Include="System.Net.Http.Json" Version="9.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\Base\" />
  </ItemGroup>

</Project>
